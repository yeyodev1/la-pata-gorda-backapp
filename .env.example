# La Pata Gorda API
PORT=8400
MONGODB_URI=
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=12h
CORS_ORIGINS=
PUBLIC_APP_URL=http://localhost:5190
# Clave que autoriza las rutas internas (cron / integraciones)
CRON_KEY=
# Asistente (Claude). Vacío = el asistente responde con reglas locales, sin IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Payphone (pasarela de pago). Vacío = solo pago en local / al recibir.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# URL pública de la tienda (retorno de Payphone y links de seguimiento)
SHOP_URL=http://localhost:5190

# Cloudinary (fotos del menú)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (mapa del checkout y km de delivery)
GOOGLE_MAPS_API_KEY=
