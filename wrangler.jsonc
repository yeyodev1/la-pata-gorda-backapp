{
  // API de La Pata Gorda en Cloudflare Workers (Express 5 + Mongoose 9 sobre nodejs_compat).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "la-pata-gorda-api",
  // Cuenta "bakano town" (subdominio bakanoagency.workers.dev)
  "account_id": "4c5de28d502b308c4a7fd8b294e032a5",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Cierre diario: 06:00 UTC = 01:00 Ecuador (consolida ventas del día y genera sugerencias de pedido).
  "triggers": { "crons": ["0 6 * * *"] },
  // La API vive en una sola instancia de Durable Object (conserva la conexión a Mongo entre peticiones).
  "durable_objects": { "bindings": [{ "name": "API", "class_name": "PataGordaApi" }] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PataGordaApi"] }],
  "vars": {
    "NODE_ENV": "production",
    "JWT_EXPIRES_IN": "12h",
    "DO_LOCATION_HINT": "enam",
    "CORS_ORIGINS": "https://la-pata-gorda-app.bakanoagency.workers.dev",
    "PUBLIC_APP_URL": "https://la-pata-gorda-app.bakanoagency.workers.dev"
  }
  // Secretos (NO van aquí): MONGODB_URI, JWT_SECRET, CRON_KEY, ANTHROPIC_API_KEY
  //   npx wrangler secret put MONGODB_URI
  //   npx wrangler secret put JWT_SECRET
}
